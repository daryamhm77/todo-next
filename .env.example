# Local (Docker)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
MONGO_USER=milad
MONGO_PASS=12345
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASS}@127.0.0.1:27017/todolist?authSource=admin

# Vercel (set these in the Vercel dashboard, Production + Preview)
# NEXTAUTH_URL=https://your-app.vercel.app
# NEXTAUTH_SECRET=generate-with: openssl rand -base64 32
# MONGO_USER=your_atlas_user
# MONGO_PASS=your_atlas_password
# MONGO_URI=mongodb+srv://${MONGO_USER}:${MONGO_PASS}@cluster0.xxxxx.mongodb.net/todolist?retryWrites=true&w=majority
