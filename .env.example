# Local (Docker)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
MONGO_USER=milad
MONGO_PASS=12345
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASS}@127.0.0.1:27017/todolist?authSource=admin

# Vercel Storage (MongoDB Atlas) injects MONGODB_URI automatically
# when you connect the database to this project. Pull it locally with:
#   npx vercel env pull .env.local
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=todolist
